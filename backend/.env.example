# Port for the Express backend server (default: 3000)
PORT=3000

# Port for the embedded MQTT broker (default: 1883)
MQTT_PORT=1883

# Optional: URL of an external MQTT broker (e.g. mqtt://localhost:1883 or mqtt://broker.hivemq.com:1883)
# If left blank, the backend automatically runs its own embedded MQTT broker on MQTT_PORT
MQTT_BROKER_URL=

# Optional API key for securing POST /api/readings
# Leave blank to allow open unauthenticated ingestion
API_KEY=
